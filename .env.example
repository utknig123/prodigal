# Copy to .env (git-ignored). Never commit real keys.
# AWS access keys go through `aws configure`, not this file. Never put your AWS console password here.

CANDIDATE_API_URL=https://candidate-db-api.service.external.usea2.aws.prodigaltech.com
CANDIDATE_API_KEY=

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
# This Groq workspace lists openai/gpt-oss-20b (tools work). Change if your account has others.
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
LLM_API_KEY=

AWS_REGION=ap-south-1
STACK_NAME=prodigal-dev
